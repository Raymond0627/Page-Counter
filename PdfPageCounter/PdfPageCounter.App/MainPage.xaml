<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PdfPageCounter_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PdfPageCounter_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PdfPageCounter.Core.Models"
    xmlns:vm="using:PdfPageCounter_App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="TagButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <TabView IsAddTabButtonVisible="False" TabWidthMode="SizeToContent"
             Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <TabView.TabItems>

            <!-- ======================= Scan tab ======================= -->
            <TabViewItem Header="Scan">
                <Grid Padding="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top bar -->
                    <Border Grid.Row="0" Padding="12,8" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="BrowseButton" Content="Browse Local…"
                                        Click="BrowseButton_Click" />
                                <TextBox x:Name="PathTextBox" Width="380" PlaceholderText="Path or \\server\share\folder"
                                         Text="{Binding NetworkPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="PathTextBox_KeyDown" />
                                <Button Content="Scan" Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding ScanCommand}" />
                                <Button Content="Cancel"
                                        Command="{Binding CancelCommand}"
                                        Visibility="{Binding Summary.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentRoot, FallbackValue='(no folder selected)'}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- Error banner -->
                    <InfoBar x:Name="ErrorInfoBar" Grid.Row="1"
                             Severity="Error" IsOpen="{Binding HasError}"
                             Title="{Binding ErrorMessage}"
                             Margin="12,8,12,0" />

                    <!-- Cancelled banner -->
                    <InfoBar Grid.Row="1" Severity="Warning" IsOpen="{Binding Summary.ShowCancelledBanner}"
                             Title="Scan cancelled — results are partial."
                             Margin="12,8,12,0" />

                    <!-- Main content -->
                    <Grid Grid.Row="2" Margin="12,8,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Folder tree -->
                        <Border Grid.Column="0" Padding="8" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Folders" FontWeight="SemiBold" Margin="4,0,0,4" />
                                <TreeView x:Name="FolderTree"
                                          Grid.Row="1"
                                          ItemsSource="{Binding TreeRoots}"
                                          SelectionMode="Single"
                                          ItemInvoked="FolderTree_ItemInvoked">
                                    <TreeView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FolderNodeViewModel">
                                            <TreeViewItem ItemsSource="{x:Bind Children}">
                                                <TreeViewItem.Content>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                                        <TextBlock Text="{x:Bind DisplayLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                CornerRadius="8" Padding="6,1"
                                                                Visibility="{x:Bind HasBadge, Mode=OneWay}">
                                                            <TextBlock Text="{x:Bind BadgeText, Mode=OneWay}" Foreground="White"
                                                                       FontSize="11" FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                </TreeViewItem.Content>
                                            </TreeViewItem>
                                        </DataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Grid>
                        </Border>

                        <!-- Right: Summary and file detail -->
                        <Grid Grid.Column="2" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Scope indicator -->
                            <TextBlock Grid.Row="0" Text="{Binding Summary.ScopeText}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Summary.HasScope, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       ToolTipService.ToolTip="{Binding Summary.ScopeText}" />

                            <!-- Summary cards (Pages/Files always; Duplicates/Unique per settings) -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                                <Border MinWidth="150" Style="{StaticResource SummaryCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Total Pages" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock FontSize="26" FontWeight="Bold" Text="{Binding Summary.TotalPagesText}" />
                                    </StackPanel>
                                </Border>
                                <Border MinWidth="150" Style="{StaticResource SummaryCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Total Files" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock FontSize="26" FontWeight="Bold" Text="{Binding Summary.TotalFilesText}" />
                                    </StackPanel>
                                </Border>
                                <Border MinWidth="150" Style="{StaticResource SummaryCardStyle}"
                                        Visibility="{Binding Settings.ShowDuplicateCount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="Duplicate Files" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock FontSize="26" FontWeight="Bold" Text="{Binding Summary.DuplicateFileCountText}" />
                                    </StackPanel>
                                </Border>
                                <Border MinWidth="150" Style="{StaticResource SummaryCardStyle}"
                                        Visibility="{Binding Settings.ShowDuplicatePages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="Duplicate Pages" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock FontSize="26" FontWeight="Bold" Text="{Binding Summary.DuplicatePagesText}" />
                                    </StackPanel>
                                </Border>
                                <Border MinWidth="150" Style="{StaticResource SummaryCardStyle}"
                                        Visibility="{Binding Settings.ShowUniquePageCount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="Unique Pages" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock FontSize="26" FontWeight="Bold" Text="{Binding Summary.UniquePageTotalText}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Scanning status -->
                            <StackPanel Grid.Row="2" Spacing="4">
                                <ProgressBar IsIndeterminate="True"
                                             Visibility="{Binding Summary.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             Maximum="100" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Summary.ScanningLabel}" FontWeight="SemiBold"
                                               Visibility="{Binding Summary.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding Summary.ProgressText}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- File detail table -->
                            <Border Grid.Row="3" Padding="8" CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Files in selected folder"
                                               FontWeight="SemiBold" Margin="4,0,0,4" />
                                    <ListView Grid.Row="1" ItemsSource="{Binding SelectedFolderFiles}"
                                              SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:PdfFileRecord">
<Grid Padding="4,2" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="80" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           ToolTipService.ToolTip="{x:Bind FullPath}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind PageCount, Mode=OneTime}"
                                                           VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                        <Border Background="#FFB900" CornerRadius="8" Padding="6,1"
                                                                Visibility="{x:Bind IsError, Mode=OneTime}">
                                                            <TextBlock Text="Error" FontSize="11" Foreground="Black" />
                                                        </Border>
                                                        <Border Background="#107C10" CornerRadius="8" Padding="6,1"
                                                                Visibility="{x:Bind IsOriginal, Mode=OneTime}">
                                                            <TextBlock Text="Original" FontSize="11" Foreground="White" />
                                                        </Border>
                                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                CornerRadius="8" Padding="6,1"
                                                                Visibility="{x:Bind IsDuplicate, Mode=OneTime}">
                                                            <TextBlock Text="Duplicate" FontSize="11" Foreground="White" />
                                                        </Border>
                                                        <Button Style="{StaticResource TagButtonStyle}" BorderThickness="1"
                                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                Visibility="{x:Bind IsGrouped, Mode=OneTime}"
                                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                ToolTipService.ToolTip="Copy all paths in this duplicate group"
                                                                Content="Copy Paths"
                                                                Click="CopyPathsButton_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabViewItem>

            <!-- ======================= Box Count tab ======================= -->
            <TabViewItem Header="Box Count">
                <Grid Padding="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12,8" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Browse Local…" Click="BoxBrowseButton_Click" />
                                <TextBox Width="380" PlaceholderText="Path or \\server\share\folder"
                                         Text="{Binding Boxes.BoxPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="BoxPathTextBox_KeyDown" />
                                <Button Content="Scan" Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding Boxes.ScanBoxesCommand}" />
                                <Button Content="Cancel"
                                        Command="{Binding Boxes.CancelBoxesCommand}"
                                        Visibility="{Binding Boxes.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Boxes.ScopeText, FallbackValue='(no folder selected)'}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <InfoBar Grid.Row="1" Severity="Error" IsOpen="{Binding Boxes.HasError}"
                             Title="{Binding Boxes.ErrorMessage}" Margin="12,8,12,0" />

                    <Grid Grid.Row="2" Margin="12,8,12,12" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="4">
                            <ProgressBar IsIndeterminate="True"
                                         Visibility="{Binding Boxes.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Maximum="100" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Boxes.ScanningLabel}" FontWeight="SemiBold"
                                           Visibility="{Binding Boxes.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="{Binding Boxes.StatusText}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button Content="Export to Excel…"
                                        IsEnabled="{Binding Boxes.CanExport}"
                                        Click="BoxExportButton_Click" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="1" Padding="8" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Box Number" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Total PDF Files" FontWeight="SemiBold" Margin="0,0,16,0" />
                                    <TextBlock Grid.Column="2" Text="Total Pages" FontWeight="SemiBold" Margin="0,0,16,0" />
                                </Grid>
                                <ListView Grid.Row="1" ItemsSource="{Binding Boxes.Results}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BoxCountRow">
                                            <Grid ColumnSpacing="8" Padding="4,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Label}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind CountText}" FontWeight="SemiBold"
                                                           Margin="0,0,16,0" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind PageCountText}" FontWeight="SemiBold"
                                                           Margin="0,0,16,0" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabViewItem>

            <!-- ======================= Settings tab ======================= -->
            <TabViewItem Header="Settings">
                <ScrollViewer Padding="16,8">
                    <StackPanel Spacing="18" MaxWidth="640" HorizontalAlignment="Left">

                        <StackPanel Spacing="4">
                            <TextBlock Text="Theme" Style="{StaticResource SettingsSectionHeaderStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <RadioButton x:Name="ThemeSystem" Content="System" GroupName="SettingsTheme" Tag="System" Checked="ThemeRadio_Checked" />
                                <RadioButton x:Name="ThemeLight" Content="Light" GroupName="SettingsTheme" Tag="Light" Checked="ThemeRadio_Checked" />
                                <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="SettingsTheme" Tag="Dark" Checked="ThemeRadio_Checked" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Summary cards" Style="{StaticResource SettingsSectionHeaderStyle}" />
                            <ToggleSwitch Header="Show duplicate count"
                                          IsOn="{Binding Settings.ShowDuplicateCount, Mode=TwoWay}"
                                          OnContent="Duplicates appear as a card" OffContent="Duplicates hidden" />
                            <ToggleSwitch Header="Show unique page count"
                                          IsOn="{Binding Settings.ShowUniquePageCount, Mode=TwoWay}"
                                          OnContent="Unique pages appear as a card" OffContent="Unique pages hidden" />
                            <ToggleSwitch Header="Show duplicate pages"
                                          IsOn="{Binding Settings.ShowDuplicatePages, Mode=TwoWay}"
                                          OnContent="Duplicate pages appear as a card" OffContent="Duplicate pages hidden" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Duplicates" Style="{StaticResource SettingsSectionHeaderStyle}" />
                            <TextBlock Text="Which attributes must match for two PDFs to count as duplicates. Check any combination (1, 2, or 3). If none are checked, nothing is treated as a duplicate. Applies on the next scan."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <CheckBox Content="File name" IsChecked="{Binding Settings.MatchFileName, Mode=TwoWay}" />
                            <CheckBox Content="Page count" IsChecked="{Binding Settings.MatchPageCount, Mode=TwoWay}" />
                            <CheckBox Content="File size" IsChecked="{Binding Settings.MatchFileSize, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Isolate duplicates" Style="{StaticResource SettingsSectionHeaderStyle}" />
                            <TextBlock Text="Moves the extra copies of identical PDFs into a “duplicates” folder that mirrors
                                        your folder structure, keeping one original per group. You can revert it afterwards."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ToggleSwitch Header="Auto re-scan after isolate / revert"
                                          IsOn="{Binding Settings.AutoRescanAfterIsolate, Mode=TwoWay}"
                                          OnContent="Re-scans the same folder" OffContent="No automatic re-scan" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Isolate duplicates…"
                                        IsEnabled="{Binding CanIsolate}"
                                        Click="IsolateDuplicatesButton_Click" />
                                <Button Content="Revert isolation"
                                        IsEnabled="{Binding CanRevert}"
                                        Click="RevertIsolationButton_Click" />
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

        </TabView.TabItems>
    </TabView>
</Page>